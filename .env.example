# ============================================================
# 1. SMTP Configuration (GoDaddy / Microsoft 365 Business Email)
# ============================================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@elitecarsaustralia.com.au
SMTP_PASS=your_business_email_or_app_password
SMTP_FROM_EMAIL=info@elitecarsaustralia.com.au
BOOKING_NOTIFICATION_EMAIL=info@elitecarsaustralia.com.au
# Optional Microsoft Graph OAuth 2.0 (sends with MFA Authenticator ON & no App Password needed):
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ============================================================
# 2. Cloudinary Image CDN Optimization
# ============================================================
# Run `npm run upload:cloudinary` once locally to upload all /public images
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_FOLDER=elite-cars
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================================
# 3. Google Maps Platform API
# ============================================================
# Required APIs: Maps JavaScript API, Places API (New), Routes API (or Directions API), Maps Static API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional separate unrestricted/IP-restricted server key for email Static Maps:
GOOGLE_MAPS_SERVER_API_KEY=

# ============================================================
# 4. Gemini API Key for Customer Support Chatbot
# ============================================================
GEMINI_API_KEY=your_gemini_api_key

